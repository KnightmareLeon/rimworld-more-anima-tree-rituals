<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--Anima Curing Ritual-->
  <RitualObligationTargetFilterDef>
    <defName>MATR_AnimaTreeCuringRitual</defName>
    <workerClass>MoreAnimaTreeRituals.Rituals.RitualObligationTargetWorker_AnimaTreeCuringRitual</workerClass>
  </RitualObligationTargetFilterDef>

  <RitualBehaviorDef>
    <defName>MATR_AnimaTreeCuringRitual</defName>
    <durationTicks>20000</durationTicks>
    <workerClass>MoreAnimaTreeRituals.Rituals.RitualBehaviorWorker_AnimaTreeCuringRitual</workerClass>
    <roles>
      <li Class="MoreAnimaTreeRituals.Rituals.RitualRole_AnimaTreeCureRequester">
        <label>requester</label>
        <id>organizer</id>
        <required>true</required>
        <maxCount>1</maxCount>
        <defaultForSelectedColonist>true</defaultForSelectedColonist>
        <noCandidatesGizmoDesc>Need a colonist that is not psychically deaf and has a disease or ailment.</noCandidatesGizmoDesc>
        <allowChild>false</allowChild>
        <customChildDisallowMessage>Only adults can be granted a blessing from the anima tree.</customChildDisallowMessage>
      </li>
    </roles>
    <spectatorsLabel>Participants</spectatorsLabel>
    <spectatorGerund>participate</spectatorGerund>
    <stages>
      <li Class="MoreAnimaTreeRituals.Rituals.RitualStage_AnimaTreeCuringRitual">
        <defaultDuty>LinkWithAnimaTreeSecondary</defaultDuty>
        <endTriggers>
          <li Class="StageEndTrigger_DurationPercentage">
            <percentage>1</percentage>
          </li>
        </endTriggers>
        <spectateDistanceOverride>3~4</spectateDistanceOverride>
        <roleBehaviors>
          <li>
            <roleId>organizer</roleId>
            <dutyDef>MATR_RequestBoonFromAnimaTree</dutyDef>
            <customPositions>
              <li Class="RitualPosition_AnimaLinkingSpot" />
            </customPositions>
          </li>
        </roleBehaviors>
      </li>
    </stages>
  </RitualBehaviorDef>

  <RitualPatternDef>
    <defName>MATR_AnimaTreeCuringRitual</defName>
    <ritualOnlyForIdeoMembers>false</ritualOnlyForIdeoMembers>
    <ritualBehavior>MATR_AnimaTreeCuringRitual</ritualBehavior>
    <ritualTargetFilter>SelectedThing</ritualTargetFilter>
    <ritualObligationTargetFilter>MATR_AnimaTreeCuringRitual</ritualObligationTargetFilter>
    <ritualOutcomeEffect>MATR_AnimaTreeCuringRitual</ritualOutcomeEffect>
    <playsIdeoMusic>false</playsIdeoMusic>
    <alwaysStartAnytime>true</alwaysStartAnytime>
  </RitualPatternDef>

  <PreceptDef>
    <defName>MATR_AnimaTreeCuringRitual</defName>
    <label>anima curing ritual</label>
    <description>A colonist will request to cure their disease or ailment from the anima tree. The blessing requester will meditate in front of the anima tree, and if successful, the requester will cured of one disease or ailment. Otherwise, the anima tree will reject the request and the requester will not be cured. At worst, the requester may even be given another disease.</description>
    <issue>Ritual</issue>
    <preceptClass>Precept_Ritual</preceptClass>
    <visible>false</visible>
    <classic>true</classic>
    <countsTowardsPreceptLimit>false</countsTowardsPreceptLimit>
    <selectionWeight>1.0</selectionWeight>
    <ritualPatternBase>MATR_AnimaTreeCuringRitual</ritualPatternBase>
    <iconPath>UI/Icons/Rituals/MATR_AnimaTreeNaturalBlessingBestowal</iconPath>
    <usesIdeoVisualEffects>false</usesIdeoVisualEffects>
    <mergeRitualGizmosFromAllIdeos>true</mergeRitualGizmosFromAllIdeos>
    <useRepeatPenalty>true</useRepeatPenalty>
    <showRitualFloatMenuOption>false</showRitualFloatMenuOption>
  </PreceptDef>

  <RitualOutcomeEffectDef>
    <defName>MATR_AnimaTreeCuringRitual</defName>
    <workerClass>MoreAnimaTreeRituals.Rituals.RitualOutcomeEffectWorker_AnimaTreeCuringRitual</workerClass>
    <warnOnLowQuality>true</warnOnLowQuality>
    <givesDevelopmentPoints>false</givesDevelopmentPoints>
    <comps>
      <li Class="RitualOutcomeComp_ParticipantCount">
        <label>participant count</label>
        <curve>
          <points>
            <li>(0, 0.0)</li>
            <li>(1, 0.07102)</li>
            <li>(2, 0.13113)</li>
            <li>(3, 0.18202)</li>
            <li>(4, 0.22510)</li>
            <li>(5, 0.26156)</li>
            <li>(6, 0.29242)</li>
            <li>(7, 0.31855)</li>
            <li>(8, 0.34067)</li>
            <li>(9, 0.35939)</li>
            <li>(10, 0.37523)</li>
            <li>(11, 0.38865)</li>
            <li>(12, 0.40000)</li>
          </points>
        </curve>
      </li>
      <li Class="RitualOutcomeComp_PawnStatScaled">
        <label>psychic sensitivity</label>
        <roleId>organizer</roleId>
        <statDef>PsychicSensitivity</statDef>
        <scaledBy>1.0</scaledBy>
        <curve>
          <points>
            <li>(0.0, 0.0)</li>
            <li>(0.25, 0.10653)</li>
            <li>(0.5, 0.19670)</li>
            <li>(0.75, 0.27303)</li>
            <li>(1.0, 0.33765)</li>
            <li>(1.25, 0.39234)</li>
            <li>(1.5, 0.43864)</li>
            <li>(1.75, 0.47782)</li>
            <li>(2.0, 0.51100)</li>
            <li>(2.25, 0.53908)</li>
            <li>(2.5, 0.56285)</li>
            <li>(2.75, 0.58297)</li>
            <li>(3.0, 0.60000)</li>
          </points>
        </curve>
      </li>
    </comps>
    <outcomeChances>
      <li>
        <label>Faileds</label>
        <chance>0.05</chance>
        <positivityIndex>-2</positivityIndex>
        <memory>MATR_PunishingAnimaTreeNaturalBlessingBestowal</memory>
      </li>
      <li>
        <label>Compensated</label>
        <chance>0.15</chance>
        <positivityIndex>-1</positivityIndex>
        <memory>MATR_RejectedAnimaTreeNaturalBlessingBestowal</memory>
      </li>
      <li>
        <label>Successful</label>
        <chance>0.7</chance>
        <positivityIndex>1</positivityIndex>
        <memory>MATR_SuccessfulAnimaTreeNaturalBlessingBestowal</memory>
      </li>
      <li>
        <label>Perfect</label>
        <chance>0.1</chance>
        <positivityIndex>2</positivityIndex>
        <memory>MATR_PerferctAnimaTreeNaturalBlessingBestowal</memory>
      </li>
    </outcomeChances>
  </RitualOutcomeEffectDef>

</Defs>