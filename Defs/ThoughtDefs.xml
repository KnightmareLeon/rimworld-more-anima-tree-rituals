<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--Natural blessing bestowal-->
  <ThoughtDef>
    <defName>MATR_PunishingAnimaTreeNaturalBlessingBestowal</defName>
    <thoughtClass>Thought_AttendedRitual</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>punishing natural blessing bestowal</label>
        <description>The natural blessing bestowal went awry and the requester got punished.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MATR_RejectedAnimaTreeNaturalBlessingBestowal</defName>
    <thoughtClass>Thought_AttendedRitual</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>rejected natural blessing bestowal</label>
        <description>The anima tree rejected the request for a natural blessing.</description>
        <baseMoodEffect>-1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MATR_SuccessfulAnimaTreeNaturalBlessingBestowal</defName>
    <thoughtClass>Thought_AttendedRitual</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>successful natural blessing bestowal</label>
        <description>The natural blessing bestowal was a success, however the requester was not able to take the blessing well.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MATR_PerferctAnimaTreeNaturalBlessingBestowal</defName>
    <thoughtClass>Thought_AttendedRitual</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>perfect natural blessing bestowal</label>
        <description>The natural blessing bestowal was a complete success.</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MATR_ReceivedNaturalBlessing</defName>
    <durationDays>10</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>received natural blessing</label>
        <description>I was given the natural blessing by the anima tree!</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MATR_RejectedNaturalBlessing</defName>
    <durationDays>10</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>rejected natural blessing</label>
        <description>The anima tree rejected my request for a natural blessing.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MATR_PunishedByAnimaTree</defName>
    <durationDays>10</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>punished by anima tree</label>
        <description>The anima tree punished me! What did I do to deserve this?</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!--Anima soothe conjuration-->
  <ThoughtDef>
    <defName>MATR_AnimaTreeSootheMoodBoostBase</defName>
    <durationDays>3.0</durationDays>
    <stackLimit>3</stackLimit>
    <effectMultiplyingStat>PsychicSensitivity</effectMultiplyingStat>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>anima soothe feeling</label>
        <description>I feel calm and relaxed thanks to the anima tree soothe.</description>
        <baseMoodEffect>15</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MATR_AnimaTreeSootheMoodBoostNatural</defName>
    <durationDays>5.0</durationDays>
    <stackLimit>3</stackLimit>
    <effectMultiplyingStat>PsychicSensitivity</effectMultiplyingStat>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>anima soothe natural feeling</label>
        <description>I feel calm, relaxed, and joyful from the anima tree soothe..</description>
        <baseMoodEffect>25</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>