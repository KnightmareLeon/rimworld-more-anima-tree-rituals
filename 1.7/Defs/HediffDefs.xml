<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>MATR_AnimaTreeNaturalBlessing</defName>
    <label>anima tree's natural blessing</label>
    <description>A blessing granted by an anima tree to connect with nature.</description>
    <allowedMeditationFocusTypes>
      <li>Natural</li>
    </allowedMeditationFocusTypes>
    <stages>
      <li>
        <statOffsets>
        <PsychicSensitivity>0.1</PsychicSensitivity>
        </statOffsets>
      </li>
    </stages>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <duplicationAllowed>false</duplicationAllowed>
    <tendable>false</tendable>
  </HediffDef>

  <HediffDef>
    <defName>MATR_AnimaTreePsywielderBlessing</defName>
    <label>anima tree's psywielder blessing</label>
    <description>A blessing granted by an anima tree to a psycaster who can meditate in nature. The blessing grants enhancements to the psycaster's abilities.</description>
    <stages>
      <li>
        <statOffsets>
          <PsychicSensitivity>0.25</PsychicSensitivity>
          <PsychicEntropyRecoveryRate>0.2</PsychicEntropyRecoveryRate>
          <MeditationFocusGain>0.3</MeditationFocusGain>
        </statOffsets>
      </li>
    </stages>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <duplicationAllowed>false</duplicationAllowed>
    <tendable>false</tendable>
  </HediffDef>

  <HediffDef>
    <defName>MATR_AnimaCuringSeed</defName>
    <label>anima curing seed</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>A seed that greatly boosts immunity gain and significantly lessens pain. This seed will disappear after 5 days.</description>
    <stages>
      <li>
        <statOffsets>
          <ImmunityGainSpeed>1</ImmunityGainSpeed>
          <ImmunityGainSpeedFactor>2.0</ImmunityGainSpeedFactor>
          <PainShockThreshold>0.50</PainShockThreshold>
        </statOffsets>
        <painFactor>0.5</painFactor>
      </li>
    </stages>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <duplicationAllowed>false</duplicationAllowed>
    <tendable>false</tendable>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>
          <min>300000</min>
          <max>300000</max>
        </disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
        <leaveFreshWounds>false</leaveFreshWounds>
      </li>
    </comps>
  </HediffDef>

</Defs>